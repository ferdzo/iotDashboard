# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Database Configuration (PostgreSQL/TimescaleDB)
DATABASE_URL=postgresql://user:password@localhost:5432/iot_dashboard

# Consumer Configuration
CONSUMER_GROUP_NAME=db_writer
CONSUMER_NAME=worker-01
BATCH_SIZE=100
BATCH_TIMEOUT_SEC=5
PROCESSING_INTERVAL_SEC=1

# Dead-letter stream for poison batches: mqtt:dlq (fixed name, capped by TRIM_MAXLEN)
MAX_RETRIES=3
TRIM_MAXLEN=10000

# Database Table Configuration (table name is fixed: telemetry)
ENABLE_TIMESCALE=false

# Logging Configuration
LOG_LEVEL=INFO
